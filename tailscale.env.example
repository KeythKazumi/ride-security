# Tailscale auth key — copy to tailscale.env and paste a real reusable,
# non-ephemeral auth key from the admin console (Settings -> Keys).
# tailscale.env is gitignored — never commit the real key.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX
# Tailnet machine name — <site>-server-tailnet, e.g. ride-server-tailnet.
TS_HOSTNAME=ride-server-tailnet
TS_STATE_DIR=/var/lib/tailscale
TS_EXTRA_ARGS=--advertise-routes=192.168.1.0/24 --accept-dns=false
