#!/usr/bin/env bash
# Shared helper: resolves the compose files to use.
#
# Pass --host as the first argument, or set RIDE_HOST_NETWORK=1, to enable
# host networking (required for LAN discovery on Linux servers).
set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$( cd "$SCRIPT_DIR/.." && pwd )"

COMPOSE_FILES=(-f "$PROJECT_DIR/docker-compose.yml")

if [ "$1" = "--host" ]; then
    RIDE_HOST_NETWORK=1
    shift
fi

if [ "${RIDE_HOST_NETWORK:-0}" = "1" ]; then
    COMPOSE_FILES+=(-f "$PROJECT_DIR/docker-compose.host.yml")
fi

compose() {
    docker compose "${COMPOSE_FILES[@]}" "$@"
}
