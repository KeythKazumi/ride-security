DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
# For local-only testing, set this to * so any local IP can access the app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Argentina/Buenos_Aires

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels).
# Only needed when running with the cloudflared service / --profile tunnel.
# TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here
